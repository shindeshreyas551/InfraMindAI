# InfraMind AI - Windows Agent Configuration Environment Variables
AGENT_NAME=InfraMind-Windows-Agent
AGENT_VERSION=0.2.0
BACKEND_URL=http://localhost:8000/api/v1/telemetry
COLLECTION_INTERVAL_SEC=10.0
LOG_LEVEL=INFO
LOG_FILE_PATH=agent/logs/agent.log
MAX_LOG_BYTES=5242880
BACKUP_COUNT=3

# Feature Toggles
COLLECT_CPU=true
COLLECT_MEMORY=true
COLLECT_DISK=true
COLLECT_NETWORK=true
COLLECT_SYSTEM=true
COLLECT_BATTERY=true
COLLECT_PROCESSES=true
MAX_PROCESSES_TO_COLLECT=15
