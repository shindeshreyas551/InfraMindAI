PROJECT_NAME=InfraMind AI Backend API
API_V1_STR=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database (PostgreSQL required)
# Local: postgresql://inframind:inframind_secret@localhost:5432/inframind
# Neon:  postgresql://user:password@ep-xyz.region.aws.neon.tech/inframind?sslmode=require
DATABASE_URL=postgresql://inframind:inframind_secret@localhost:5432/inframind

# CORS — allowed frontend origins
BACKEND_CORS_ORIGINS=["https://infra-mind-ai-three.vercel.app","http://localhost:3000"]

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10
