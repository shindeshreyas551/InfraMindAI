PROJECT_NAME=InfraMind AI Backend API
API_V1_STR=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Database
# SQLite (local dev):  sqlite:///./inframind.db
# PostgreSQL (prod):   postgresql://user:password@localhost:5432/inframind
DATABASE_URL=sqlite:///./inframind.db

# CORS — allowed frontend origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10
